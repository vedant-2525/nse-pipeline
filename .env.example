# ==============================================================================
# Environment Configuration Template for NSE Market Data Pipeline
# Copy this file to .env and adjust variables as necessary.
# Never commit .env with real secrets to version control.
#
# Password rotation (without losing volume data):
#   1. docker exec -it nse_postgres psql -U postgres -c "ALTER USER postgres PASSWORD 'new_password';"
#   2. Update POSTGRES_PASSWORD in your .env file.
#   3. Restart the container: docker compose restart postgres
# ==============================================================================

# Logging level for the pipeline
LOG_LEVEL=INFO

# PostgreSQL Warehouse (Docker Compose / Local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nse_warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
