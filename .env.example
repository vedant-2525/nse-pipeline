# ==============================================================================
# Environment Configuration Template for NSE Market Data Pipeline
# Copy this file to .env and adjust variables as necessary.
# Never commit .env with real secrets to version control.
# ==============================================================================

# Pipeline Environment
PIPELINE_ENV=development
LOG_LEVEL=INFO

# Storage paths (relative to project root or absolute)
BRONZE_DATA_PATH=./data/bronze
SILVER_DATA_PATH=./data/silver
QUARANTINE_DATA_PATH=./data/quarantine

# PostgreSQL Warehouse (Docker Compose / Local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nse_warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nse_warehouse

# Streamlit Dashboard
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
